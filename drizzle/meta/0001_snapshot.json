        "updates_opted_in": {
          "name": "updates_opted_in",
          "type": "integer",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        }
      },
      "name": "fan_signups",
      "isExisting": false,
      "definition": "\n  SELECT e.presale_id, e.partner_id,\n    (e.updates_opt_in_at IS NOT NULL OR t.updates_opt_in_at IS NOT NULL) AS updates_opted_in\n  FROM signups e LEFT JOIN text_signups t ON t.email_signup_id = e.id\n  UNION ALL\n  SELECT presale_id, partner_id, updates_opt_in_at IS NOT NULL AS updates_opted_in\n  FROM text_signups WHERE email_signup_id IS NULL\n"
    }
  },
